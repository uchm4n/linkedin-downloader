# Copy to .env and fill in. .env is gitignored.
# LINKEDIN_EMAIL only prefills the login form. The tool never types your password:
# you type it yourself, in a real Chrome window, once.
# Optional: where downloads go. Overridden by --output-dir on the command line.
# Defaults to ./downloads relative to wherever you run the tool from.

LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=
COURSES=https://www.linkedin.com/learning/course1,https://www.linkedin.com/learning/course2
DOWNLOADS_DIR=
